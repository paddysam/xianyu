# 复制此文件为 .env 并填写你的 MySQL 连接信息
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=xianyu_assistant

# 后端监听端口（插件里填 http://127.0.0.1:8788）
PORT=8788

# 简单访问令牌：插件请求头需带 X-Auth-Token 一致才放行（留空则不校验）
AUTH_TOKEN=

# Telegram 机器人（可选）：填了这两项，服务器就能收你发给机器人的指令，
# 远程「库存」查询 /「补货」入库（只响应 TG_CHAT_ID 这一个人的消息）
TG_BOT_TOKEN=
TG_CHAT_ID=
