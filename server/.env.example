# 复制此文件为 .env 并填写你的 MySQL 连接信息
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=xianyu_assistant

# 后端监听端口（插件里填 http://127.0.0.1:8788）
PORT=8788

# 监听地址。默认（留空）就是 127.0.0.1，只本机。
# 要改成 0.0.0.0 或其他网卡，必须同时设置下面的 AUTH_TOKEN，否则进程拒绝启动。
BIND_HOST=127.0.0.1

# 访问令牌。插件请求头需带同样的 X-Auth-Token。
# 本机回环可以留空；一旦 BIND_HOST 不是 127.0.0.1 / localhost / ::1，留空会拒绝启动。
AUTH_TOKEN=

# Telegram 机器人（可选）：填了这两项，服务器就能收你发给机器人的指令，
# 远程「库存」查询 /「补货」入库（只响应 TG_CHAT_ID 这一个人的消息）
TG_BOT_TOKEN=
TG_CHAT_ID=

# ── 卡网自动进货（三项都填才启用；不填=纯本地库存，行为与从前一致）──
# SHOP_BASE_URL=https://shop.freeymxz.com
# SHOP_API_KEY=卡网用户中心申请的 API Key
# SHOP_API_SECRET=对应的 API Secret
# SHOP_DELIVER_WAIT_MS=15000      # 发货请求内最多等卡网交付多久（毫秒）
